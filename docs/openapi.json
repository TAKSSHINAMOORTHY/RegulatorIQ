{
  "components": {
    "schemas": {
      "AskOptions": {
        "additionalProperties": false,
        "description": "Execution options for regulatory search and generation.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Regulatory point-in-time date constraint (YYYY-MM-DD)",
            "title": "As Of"
          },
          "doc_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Filter documents by category/type",
            "title": "Doc Types"
          },
          "include_superseded": {
            "default": false,
            "description": "Whether to include superseded documents",
            "title": "Include Superseded",
            "type": "boolean"
          },
          "interactive": {
            "default": true,
            "description": "Allow clarification request vs emit assumption",
            "title": "Interactive",
            "type": "boolean"
          }
        },
        "title": "AskOptions",
        "type": "object"
      },
      "AskRequest": {
        "additionalProperties": false,
        "description": "Input payload for POST /ask.",
        "properties": {
          "history": {
            "description": "Recent conversation turns (max 4 round-trips)",
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            },
            "maxItems": 8,
            "title": "History",
            "type": "array"
          },
          "options": {
            "$ref": "#/components/schemas/AskOptions",
            "description": "Search and generation options"
          },
          "question": {
            "description": "Regulatory question",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "ConversationTurn": {
        "additionalProperties": false,
        "description": "Single turn in previous conversation context.",
        "properties": {
          "content": {
            "description": "Turn content",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "Speaker role",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ConversationTurn",
        "type": "object"
      },
      "FeedbackRequest": {
        "additionalProperties": false,
        "description": "Input payload for POST /feedback.",
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional user comment",
            "title": "Comment"
          },
          "rating": {
            "description": "User rating",
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "wrong_fact",
                  "outdated",
                  "missing_citation",
                  "unhelpful",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Category reason for rating",
            "title": "Reason"
          },
          "request_id": {
            "description": "UUID of the /ask request being rated",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "rating"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Output payload for GET /health.",
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "uptime_s": {
            "title": "Uptime S",
            "type": "number"
          }
        },
        "required": [
          "uptime_s"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MetaCorpus": {
        "additionalProperties": false,
        "description": "Corpus summary stats for GET /meta.",
        "properties": {
          "as_of_crawl_date": {
            "title": "As Of Crawl Date",
            "type": "string"
          },
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "doc_types": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Doc Types",
            "type": "object"
          },
          "documents": {
            "title": "Documents",
            "type": "integer"
          }
        },
        "required": [
          "documents",
          "chunks",
          "as_of_crawl_date",
          "doc_types"
        ],
        "title": "MetaCorpus",
        "type": "object"
      },
      "MetaLimits": {
        "additionalProperties": false,
        "description": "Request quotas and bounds for GET /meta.",
        "properties": {
          "max_history_turns": {
            "title": "Max History Turns",
            "type": "integer"
          },
          "max_question_chars": {
            "title": "Max Question Chars",
            "type": "integer"
          }
        },
        "required": [
          "max_question_chars",
          "max_history_turns"
        ],
        "title": "MetaLimits",
        "type": "object"
      },
      "MetaResponse": {
        "additionalProperties": false,
        "description": "Output payload for GET /meta.",
        "properties": {
          "app": {
            "default": "RegulatorIQ",
            "title": "App",
            "type": "string"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "corpus": {
            "$ref": "#/components/schemas/MetaCorpus"
          },
          "degraded_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degraded Notice"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "disclaimer_key": {
            "default": "regulatory_disclaimer",
            "title": "Disclaimer Key",
            "type": "string"
          },
          "index_version": {
            "title": "Index Version",
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/MetaLimits"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "mode",
          "index_version",
          "corpus",
          "capabilities",
          "limits",
          "disclaimer"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": false,
        "description": "Output payload for GET /ready.",
        "properties": {
          "chunk_count": {
            "title": "Chunk Count",
            "type": "integer"
          },
          "degraded": {
            "items": {
              "type": "string"
            },
            "title": "Degraded",
            "type": "array"
          },
          "elapsed_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elapsed S"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          },
          "index_version": {
            "title": "Index Version",
            "type": "string"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "warmup_enabled": {
            "title": "Warmup Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "mode",
          "index_version",
          "chunk_count",
          "degraded",
          "warmup_enabled",
          "version",
          "started_at"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "additionalProperties": false,
        "description": "Output payload for GET /version.",
        "properties": {
          "build_time": {
            "title": "Build Time",
            "type": "string"
          },
          "git_sha": {
            "title": "Git Sha",
            "type": "string"
          },
          "index_version": {
            "title": "Index Version",
            "type": "string"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "git_sha",
          "index_version",
          "mode",
          "build_time"
        ],
        "title": "VersionResponse",
        "type": "object"
      },
      "WarmupResponse": {
        "additionalProperties": false,
        "description": "Output payload for POST /warmup.",
        "properties": {
          "llm_called": {
            "default": false,
            "title": "Llm Called",
            "type": "boolean"
          },
          "mode": {
            "title": "Mode",
            "type": "string"
          },
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Timings Ms",
            "type": "object"
          }
        },
        "required": [
          "mode",
          "timings_ms"
        ],
        "title": "WarmupResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Production Agentic RAG API over Official Reserve Bank of India (RBI) Regulations",
    "title": "RegulatorIQ API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ask": {
      "post": {
        "description": "Execute regulatory analysis with streaming SSE or non-streaming JSON.",
        "operationId": "ask_question_ask_post",
        "parameters": [
          {
            "in": "header",
            "name": "accept",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "text/event-stream",
              "title": "Accept"
            }
          },
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Ask Question Ask Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask Question",
        "tags": [
          "Regulatory Q&A"
        ]
      }
    },
    "/feedback": {
      "post": {
        "description": "Submit rating and feedback for an /ask request.",
        "operationId": "submit_feedback_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Feedback",
        "tags": [
          "Feedback"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return service liveness status and uptime.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "System"
        ]
      }
    },
    "/meta": {
      "get": {
        "description": "Return public engine metadata and corpus statistics with 60s cache header.",
        "operationId": "get_metadata_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Metadata",
        "tags": [
          "Metadata"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Return Prometheus-formatted operational metrics.",
        "operationId": "get_metrics_metrics_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Metrics",
        "tags": [
          "Operations"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Return service readiness and loaded engine metadata.",
        "operationId": "get_ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Ready",
        "tags": [
          "System"
        ]
      }
    },
    "/version": {
      "get": {
        "description": "Return version and commit identification.",
        "operationId": "get_version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Version",
        "tags": [
          "Metadata"
        ]
      }
    },
    "/warmup": {
      "post": {
        "description": "Pre-warm retrieval and reranking models without consuming LLM budget.",
        "operationId": "execute_warmup_warmup_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarmupResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Execute Warmup",
        "tags": [
          "Operations"
        ]
      }
    }
  }
}