# RegulatorIQ Production Environment Configuration
# Copy this file to .env and customize values for your deployment.

# Execution Environment
ENV=prod                               # prod | dev | test
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# Access & Documentation
DOCS_ENABLED=0                         # Set to 1 to enable /docs and /redoc (requires ALLOW_DOCS_IN_PROD=1 in prod)
ALLOW_DOCS_IN_PROD=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
WARMUP_TOKEN=                          # Secret token for POST /warmup
METRICS_TOKEN=                         # Secret token for GET /metrics
API_KEYS=                              # Optional comma-separated API keys for POST /ask (when set, X-API-Key required)

# Engine & Artifacts
INDEX_DIR=artifacts/index/2.1.0-BAAI_bge-small-en-v1_5-799bed3e
INDEX_URL=                             # Remote URL to download index tarball if missing
INDEX_SHA256=                          # Expected SHA-256 checksum of remote index
VECTOR_BACKEND=faiss                   # faiss | numpy
RAG_LIGHT_MODE=0                       # Set to 1 for BM25-only light mode
AGENT_CONFIG_PATH=config/agent.yaml

# LLM Provider Configuration
LLM_PROVIDER=auto                      # auto | gemini | groq | openai | extractive | rules
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=

# Concurrency & Caps
MAX_BODY_BYTES=16384                   # 16 KB max request body
MAX_QUESTION_CHARS=1000
MAX_HISTORY_TURNS=4
MAX_CONCURRENT_ASKS=2
ASK_QUEUE_TIMEOUT_S=5.0
REQUEST_TIMEOUT_S=45.0

# Rate Limiting & Quotas
ASK_RPM=12
ASK_BURST=4
ASK_DAILY_PER_IP=150
GLOBAL_DAILY_LLM_CALLS=800
WARMUP_DAILY_CAP=24
TRUSTED_PROXIES=                       # Comma-separated trusted reverse proxy IPs

# Observability & Tracing
TRACE_SAMPLE_RATE=1.0
TRACE_REDACT_QUESTIONS=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Feedback Storage
FEEDBACK_SINK=jsonl                    # jsonl | sqlite | none
FEEDBACK_PATH=data/feedback/feedback.jsonl

# Build & Metadata
GIT_SHA=unknown
