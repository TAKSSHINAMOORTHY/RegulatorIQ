# RegulatorIQ Environment Configuration

# Crawler & Ingest Settings
CRAWLER_CONTACT=https://github.com/TAKSSHINAMOORTHY/RegulatorIQ
REQUEST_DELAY_SECONDS=2.5
MAX_CONCURRENCY=1
TIMEOUT=30
MAX_DOCS=
DRY_RUN=false

# Storage Overrides (Optional - defaults to repo relative paths)
RBI_DATA_DIR=
RBI_ARTIFACTS_DIR=

# LLM Providers (for Phase 4+)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=

# API & Server Settings (for Phase 7+)
HOST=0.0.0.0
PORT=8000
ENV=development
WARMUP_TOKEN=
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
